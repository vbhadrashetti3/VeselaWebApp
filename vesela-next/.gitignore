# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage


# next.js
/.next/
/out/
 
# production
/build

# misc
.DS_Store
*.pem

# voice orb media — served from a CDN/bucket, too large for git history.
# Set NEXT_PUBLIC_VOICE_ASSET_BASE_URL to the hosted location.
/public/voice/*.mp4

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
